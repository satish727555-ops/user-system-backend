<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Creatio</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background: #cbd5e1; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 15px; }
        .container { background: #fff; width: 950px; max-width: 100%; height: 580px; border-radius: 24px; display: flex; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15); }
        .form-side { flex: 1; background: linear-gradient(135deg, #f8f6f0, #faecd1); padding: 40px; display: flex; flex-direction: column; justify-content: center; position: relative; }
        .logo { position: absolute; top: 25px; left: 40px; font-weight: bold; color: #444; background: rgba(255,255,255,0.7); padding: 5px 15px; border-radius: 10px; }
        .header { text-align: center; margin-bottom: 20px; }
        .header h2 { font-size: 24px; margin-bottom: 5px; }
        .header p { font-size: 13px; color: #666; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-size: 11px; color: #777; margin-bottom: 5px; padding-left: 15px; }
        .form-group input { width: 100%; padding: 12px 20px; border: 1px solid rgba(0,0,0,0.05); border-radius: 30px; font-size: 13px; outline: none; }
        .form-group input:focus { border-color: #ffcc29; }
        .submit-btn { width: 100%; padding: 13px; background: #ffcc29; border: none; border-radius: 30px; font-size: 14px; font-weight: bold; cursor: pointer; margin-top: 5px; }
        #otp-section { display: none; }
        .otp-inputs { display: flex; justify-content: center; gap: 8px; margin: 20px 0; }
        .otp-box { width: 40px; height: 40px; text-align: center; font-size: 18px; font-weight: bold; border: 1px solid #ddd; border-radius: 8px; outline: none; }
        .otp-box:focus { border-color: #ffcc29; }
        .social-section { display: flex; gap: 10px; margin-top: 15px; }
        .social-btn { flex: 1; padding: 10px; background: rgba(255,255,255,0.8); border: 1px solid rgba(0,0,0,0.06); border-radius: 30px; font-size: 12px; cursor: pointer; }
        .footer { display: flex; justify-content: space-between; margin-top: 30px; font-size: 11px; color: #888; }
        .footer a { color: #444; text-decoration: none; font-weight: 500; }
        .image-side { flex: 1.1; background: url('https://unsplash.com') center/cover; position: relative; padding: 25px; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; }
        .top-badge { position: absolute; top: 25px; left: 25px; background: #fde047; padding: 8px 14px; border-radius: 10px; font-size: 11px; font-weight: bold; }
        .glass-box { background: rgba(255,255,255,0.25); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); border-radius: 14px; padding: 12px 18px; color: #fff; }
        @media (max-width: 800px) { .image-side { display: none; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-side">
            <div class="logo">Creatio</div>
            
            <!-- 1. Signup block -->
            <div id="signup-section">
                <div class="header"><h2>Create an account</h2><p>Sign up and get 30 day free trial</p></div>
                <form id="regForm">
                    <div class="form-group"><label>Username</label><input type="text" id="username" placeholder="Amélie Laurent" required></div>
                    <div class="form-group"><label>Email</label><input type="email" id="email" placeholder="amelielaurent@gmail.com" required></div>
                    <!-- Frontend validation minlength="6" set kar diya hai -->
                    <div class="form-group"><label>Password</label><input type="password" id="password" placeholder="••••••••" minlength="6" required></div>
                    <button type="submit" class="submit-btn">Submit & Send OTP</button>
                </form>
                <div class="social-section">
                    <button class="social-btn"> Apple</button>
                    <button class="social-btn">Google</button>
                </div>
            </div>

            <!-- 2. Corrected 6-Digit OTP block -->
            <div id="otp-section">
                <div class="header"><h2>Verify Your Email</h2><p>Enter 6-digit code sent to your email.</p></div>
                <form id="otpForm">
                    <div class="otp-inputs">
                        <input type="text" class="otp-box" id="o1" maxlength="1" required oninput="move(this, 'o2')">
                        <input type="text" class="otp-box" id="o2" maxlength="1" required oninput="move(this, 'o3')">
                        <input type="text" class="otp-box" id="o3" maxlength="1" required oninput="move(this, 'o4')">
                        <input type="text" class="otp-box" id="o4" maxlength="1" required oninput="move(this, 'o5')">
                        <input type="text" class="otp-box" id="o5" maxlength="1" required oninput="move(this, 'o6')">
                        <input type="text" class="otp-box" id="o6" maxlength="1" required>
                    </div>
                    <button type="submit" class="submit-btn">Verify OTP</button>
                </form>
            </div>

            <div class="footer"><span>Already a user? <a href="/login">Sign in</a></span><a href="#">Terms</a></div>
        </div>

        <div class="image-side">
            <div class="top-badge">Task Review With Team</div>
            <div class="glass-box"><h4>Project Calendar</h4><p>22 23 24 25 26 27 28</p></div>
        </div>
    </div>

    <script>
        let userEmail = "";

        // Registration form submission handler
        document.getElementById('regForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            userEmail = document.getElementById('email').value;
            const passwordValue = document.getElementById('password').value;

            // Frontend password character check logic
            if (passwordValue.length < 6) {
                alert("Password must contain at least 6 characters.");
                return;
            }

            // AJAX request matching your backend route
            const res = await fetch('/register', { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: document.getElementById('username').value,
                    email: userEmail,
                    password: passwordValue
                })
            });

            const data = await res.json();
            if(data.success) {
                document.getElementById('signup-section').style.display = 'none';
                document.getElementById('otp-section').style.display = 'block';
                document.getElementById('o1').focus();
            } else {
                alert(data.message);
            }
        });

        // OTP form submission handler
        document.getElementById('otpForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const fullOTP = ['o1','o2','o3','o4','o5','o6'].map(id => document.getElementById(id).value).join('');

            const res = await fetch('/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: userEmail, otp: fullOTP })
            });

            const data = await res.json();
            if(data.success) {
                alert(data.message);
                window.location.href = data.redirect || '/login';
            } else {
                alert(data.message);
            }
        });

        function move(curr, nextId) { if (curr.value.length >= 1) document.getElementById(nextId).focus(); }
    </script>
</body>
</html>