
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User System | Create Account</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
        }

        .auth-card {
            box-shadow:
                0 30px 80px rgba(15, 23, 42, .20),
                0 8px 25px rgba(15, 23, 42, .08);
        }

        .field {
            transition: all .2s ease;
        }

        .field:focus {
            box-shadow: 0 0 0 4px rgba(79, 70, 229, .08);
        }

        .btn {
            transition: all .2s ease;
        }

        .btn:active {
            transform: scale(.985);
        }
    </style>
</head>

<body class="min-h-screen bg-[#f8fafc] flex items-center justify-center p-4">

    <!-- Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-[500px] h-[500px]
                    rounded-full bg-indigo-100/70 blur-3xl"></div>

        <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px]
                    rounded-full bg-blue-100/60 blur-3xl"></div>
    </div>


    <main class="relative w-full max-w-5xl">

        <div class="auth-card bg-white rounded-[28px] overflow-hidden
                    border border-slate-200 grid md:grid-cols-[.9fr_1.1fr]">


            <!-- BRAND PANEL -->
            <aside class="hidden md:flex bg-slate-950 text-white p-10
                          flex-col justify-between">

                <div>

                    <!-- Logo -->
                    <div class="flex items-center gap-3">

                        <div class="w-11 h-11 rounded-xl
                                    bg-indigo-600 flex items-center
                                    justify-center font-bold text-lg">
                            U
                        </div>

                        <div>
                            <p class="font-bold tracking-tight">
                                User System
                            </p>

                            <p class="text-xs text-slate-400">
                                Secure Authentication
                            </p>
                        </div>

                    </div>


                    <!-- Main -->
                    <div class="mt-28">

                        <p class="text-indigo-400 text-sm font-semibold mb-3">
                            WELCOME
                        </p>

                        <h1 class="text-4xl font-bold leading-tight">
                            Everything starts
                            <br>
                            with your account.
                        </h1>

                        <p class="text-slate-400 mt-5 leading-7 max-w-sm">
                            A secure authentication experience built
                            with email verification and protected access.
                        </p>

                    </div>

                </div>


                <!-- Security -->
                <div class="space-y-4 text-sm">

                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-white/5
                                     flex items-center justify-center">
                            ✓
                        </span>

                        <span class="text-slate-300">
                            Encrypted password storage
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-white/5
                                     flex items-center justify-center">
                            ✓
                        </span>

                        <span class="text-slate-300">
                            Email verification
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-white/5
                                     flex items-center justify-center">
                            ✓
                        </span>

                        <span class="text-slate-300">
                            Secure JWT authentication
                        </span>
                    </div>

                </div>

            </aside>


            <!-- FORM PANEL -->
            <section class="p-6 sm:p-10 lg:p-12">


                <!-- Mobile Brand -->
                <div class="md:hidden flex items-center gap-3 mb-8">

                    <div class="w-10 h-10 rounded-xl bg-indigo-600
                                text-white flex items-center justify-center
                                font-bold">
                        U
                    </div>

                    <div>
                        <p class="font-bold text-slate-900">
                            User System
                        </p>

                        <p class="text-xs text-slate-400">
                            Secure Authentication
                        </p>
                    </div>

                </div>


                <!-- Header -->
                <div class="mb-8">

                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>

                        <span class="text-xs font-semibold
                                     text-indigo-600 uppercase tracking-wider">
                            Account Setup
                        </span>
                    </div>

                    <h2 id="title"
                        class="text-3xl font-bold tracking-tight text-slate-900">
                        Create your account
                    </h2>

                    <p id="subtitle"
                       class="text-slate-500 mt-2">
                        Enter your details to get started.
                    </p>

                </div>


                <!-- REGISTER -->
                <form id="registerForm" class="space-y-5">


                    <!-- Name -->
                    <div>

                        <label class="block text-sm font-semibold
                                      text-slate-700 mb-2">
                            Full name
                        </label>

                        <input
                            id="username"
                            type="text"
                            placeholder="Enter your full name"
                            autocomplete="name"
                            class="field w-full px-4 py-3.5 rounded-xl
                                   border border-slate-200 bg-white
                                   outline-none
                                   focus:border-indigo-500
                                   placeholder:text-slate-400"
                            required
                        >

                    </div>


                    <!-- Email -->
                    <div>

                        <label class="block text-sm font-semibold
                                      text-slate-700 mb-2">
                            Email address
                        </label>

                        <input
                            id="email"
                            type="email"
                            placeholder="name@example.com"
                            autocomplete="email"
                            class="field w-full px-4 py-3.5 rounded-xl
                                   border border-slate-200 bg-white
                                   outline-none
                                   focus:border-indigo-500
                                   placeholder:text-slate-400"
                            required
                        >

                    </div>


                    <!-- Password -->
                    <div>

                        <div class="flex justify-between items-center mb-2">

                            <label class="text-sm font-semibold text-slate-700">
                                Password
                            </label>

                            <span id="passwordStrength"
                                  class="text-xs text-slate-400">
                                8+ characters
                            </span>

                        </div>


                        <div class="relative">

                            <input
                                id="password"
                                type="password"
                                placeholder="Create a strong password"
                                autocomplete="new-password"
                                class="field w-full px-4 py-3.5 pr-12
                                       rounded-xl border border-slate-200
                                       bg-white outline-none
                                       focus:border-indigo-500
                                       placeholder:text-slate-400"
                                required
                            >

                            <button
                                type="button"
                                onclick="togglePassword()"
                                class="absolute right-4 top-1/2
                                       -translate-y-1/2 text-slate-400
                                       hover:text-indigo-600">
                                <span id="eye">👁</span>
                            </button>

                        </div>


                        <div class="flex gap-1 mt-2">

                            <span id="bar1"
                                  class="h-1 flex-1 rounded-full bg-slate-100"></span>

                            <span id="bar2"
                                  class="h-1 flex-1 rounded-full bg-slate-100"></span>

                            <span id="bar3"
                                  class="h-1 flex-1 rounded-full bg-slate-100"></span>

                            <span id="bar4"
                                  class="h-1 flex-1 rounded-full bg-slate-100"></span>

                        </div>

                    </div>


                    <!-- Error -->
                    <div id="message"
                         class="hidden rounded-xl px-4 py-3 text-sm
                                bg-red-50 text-red-600
                                border border-red-100">
                    </div>


                    <!-- Submit -->
                    <button
                        id="registerButton"
                        type="submit"
                        class="btn w-full py-3.5 rounded-xl
                               bg-indigo-600 text-white
                               font-semibold
                               hover:bg-indigo-700
                               shadow-lg shadow-indigo-600/15
                               disabled:opacity-60
                               disabled:cursor-not-allowed">

                        Create Account

                    </button>


                    <!-- Login -->
                    <p class="text-center text-sm text-slate-500 pt-1">

                        Already have an account?

                        <a href="/api/users/login"
                           class="font-semibold text-indigo-600
                                  hover:text-indigo-700">
                            Sign in
                        </a>

                    </p>

                </form>


                <!-- OTP -->
                <form id="otpForm" class="hidden space-y-6">


                    <!-- Step -->
                    <div class="flex items-center justify-center gap-2">

                        <span class="w-8 h-8 rounded-full bg-green-100
                                     text-green-600 flex items-center
                                     justify-center text-sm font-bold">
                            ✓
                        </span>

                        <span class="w-12 h-px bg-indigo-200"></span>

                        <span class="w-8 h-8 rounded-full bg-indigo-600
                                     text-white flex items-center
                                     justify-center text-sm font-bold">
                            2
                        </span>

                    </div>


                    <div class="text-center">

                        <div class="mx-auto w-16 h-16 rounded-2xl
                                    bg-indigo-50 flex items-center
                                    justify-center text-3xl">
