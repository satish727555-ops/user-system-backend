<script>

    let registeredEmail = "";

    // Password show/hide
    function togglePassword() {
        const password = document.getElementById("password");

        if (password.type === "password") {
            password.type = "text";
        } else {
            password.type = "password";
        }
    }


    // Register
    document.getElementById("registerForm").addEventListener("submit", async function(event) {

        event.preventDefault();

        const name = document.getElementById("username").value.trim();
        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;

        const message = document.getElementById("message");
        const button = document.getElementById("registerButton");

        message.classList.add("hidden");

        button.disabled = true;
        button.innerText = "Sending OTP...";

        try {

            const response = await fetch("/api/users/register", {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    name,
                    email,
                    password
                })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || "Registration failed");
            }

            // Registration successful
            registeredEmail = email.toLowerCase().trim();

            // Hide Create Account form
            document.getElementById("registerForm").classList.add("hidden");

            // Show OTP form
            document.getElementById("otpForm").classList.remove("hidden");

            // Change heading
            document.getElementById("title").innerText = "Verify Your Email";

            document.getElementById("subtitle").innerText =
                "OTP sent successfully. Enter the OTP sent to your email.";

        } catch (error) {

            message.innerText = error.message;

            message.classList.remove("hidden");
            message.classList.add("bg-red-100", "text-red-700");

            button.disabled = false;
            button.innerText = "Create Account";
        }

    });


    // OTP Verification
    document.getElementById("otpForm").addEventListener("submit", async function(event) {

        event.preventDefault();

        const otp = document.getElementById("otp").value.trim();

        const message = document.getElementById("otpMessage");
        const button = document.getElementById("verifyButton");

        message.classList.add("hidden");

        button.disabled = true;
        button.innerText = "Verifying...";

        try {

            const response = await fetch("/api/users/verify-otp", {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    email: registeredEmail,
                    otp: otp
                })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || "OTP verification failed");
            }

            message.innerText =
                "Email verified successfully! Redirecting to login...";

            message.classList.remove("hidden");
            message.classList.add("bg-green-100", "text-green-700");

            button.innerText = "Verified ✓";

            setTimeout(() => {
                window.location.href = "/api/users/register";
            }, 2000);

        } catch (error) {

            message.innerText = error.message;

            message.classList.remove("hidden");
            message.classList.add("bg-red-100", "text-red-700");

            button.disabled = false;
            button.innerText = "Verify Email";
        }

    });

</script>