<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | User System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        html {
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100dvh;
            width: 100%;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 30px 20px;

            position: relative;
            overflow-x: hidden;
            overflow-y: auto;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(0, 210, 255, 0.22),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 90% 90%,
                    rgba(124, 58, 237, 0.28),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #050816,
                    #0b1026,
                    #111936
                );
        }

        /* Background grid */
        body::before {
            content: "";
            position: fixed;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.035) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.035) 1px,
                    transparent 1px
                );

            background-size: 45px 45px;

            opacity: 0.4;

            pointer-events: none;
        }

        /* Background glow */
        body::after {
            content: "";

            position: fixed;

            width: 450px;
            height: 450px;

            right: -200px;
            top: -200px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(0, 200, 255, 0.22),
                    transparent 68%
                );

            filter: blur(10px);

            pointer-events: none;
        }

        /* Main */
        .container {
            width: 100%;
            max-width: 430px;

            position: relative;
            z-index: 2;
        }

        /* Card */
        .card {
            width: 100%;

            padding: 34px 32px;

            border-radius: 24px;

            background: rgba(255,255,255,0.97);

            box-shadow:
                0 30px 80px rgba(0,0,0,0.48),
                0 0 0 1px rgba(255,255,255,0.20);

            position: relative;
            overflow: hidden;
        }

        /* Top gradient */
        .card::before {
            content: "";

            position: absolute;

            left: 0;
            right: 0;
            top: 0;

            height: 4px;

            background:
                linear-gradient(
                    90deg,
                    #00c6ff,
                    #0072ff,
                    #7c3aed
                );
        }

        /* Logo */
        .logo {
            width: 60px;
            height: 60px;

            margin: 0 auto 15px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 17px;

            color: white;

            font-size: 21px;
            font-weight: 800;

            background:
                linear-gradient(
                    135deg,
                    #00c6ff,
                    #0072ff,
                    #7c3aed
                );

            box-shadow:
                0 12px 28px rgba(0,114,255,0.30);
        }

        .title {
            text-align: center;

            color: #111827;

            font-size: 27px;
            font-weight: 800;

            margin-bottom: 7px;
        }

        .subtitle {
            text-align: center;

            color: #6b7280;

            font-size: 13px;

            line-height: 1.6;

            margin-bottom: 25px;
        }

        /* Fields */
        .group {
            margin-bottom: 16px;
        }

        label {
            display: block;

            color: #374151;

            font-size: 13px;
            font-weight: 700;

            margin-bottom: 7px;
        }

        .input {
            position: relative;
        }

        .input input {
            width: 100%;
            height: 50px;

            padding: 0 14px;

            border: 1px solid #d8dee8;

            border-radius: 11px;

            outline: none;

            background: #f9fafb;

            color: #111827;

            font-size: 14px;

            transition: 0.25s;
        }

        .input input:focus {
            background: #ffffff;

            border-color: #0072ff;

            box-shadow:
                0 0 0 4px rgba(0,114,255,0.10);
        }

        .input input::placeholder {
            color: #9ca3af;
        }

        /* Password */
        .password-input {
            padding-right: 48px !important;
        }

        .eye {
            position: absolute;

            right: 12px;
            top: 50%;

            transform: translateY(-50%);

            border: none;
            background: transparent;

            cursor: pointer;

            font-size: 17px;

            padding: 5px;

            color: #6b7280;
        }

        .eye:hover {
            color: #0072ff;
        }

        /* Button */
        .btn {
            width: 100%;
            height: 50px;

            margin-top: 6px;

            border: none;
            border-radius: 11px;

            color: white;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            background:
                linear-gradient(
                    135deg,
                    #00a8ff,
                    #0072ff,
                    #6d28d9
                );

            box-shadow:
                0 12px 25px rgba(0,114,255,0.25);

            transition: 0.25s;
        }

        .btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 16px 30px rgba(0,114,255,0.35);
        }

        .btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        /* Message */
        .message {
            display: none;

            margin-top: 14px;

            padding: 10px 12px;

            border-radius: 9px;

            text-align: center;

            font-size: 12px;

            line-height: 1.5;
        }

        .message.success {
            display: block;

            color: #166534;

            background: #dcfce7;

            border: 1px solid #bbf7d0;
        }

        .message.error {
            display: block;

            color: #991b1b;

            background: #fee2e2;

            border: 1px solid #fecaca;
        }

        /* Login */
        .login {
            text-align: center;

            margin-top: 19px;

            color: #6b7280;

            font-size: 13px;
        }

        .login a {
            color: #0072ff;

            font-weight: 700;

            text-decoration: none;
        }

        .login a:hover {
            text-decoration: underline;
        }

        /* Security */
        .security {
            text-align: center;

            margin-top: 15px;

            color: #9ca3af;

            font-size: 10px;
        }

        /* OTP */
        #otpSection {
            display: none;
        }

        .otp-icon {
            width: 55px;
            height: 55px;

            margin: 0 auto 14px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 16px;

            color: white;

            font-size: 23px;

            background:
                linear-gradient(
                    135deg,
                    #0072ff,
                    #7c3aed
                );
        }

        .otp-title {
            text-align: center;

            color: #111827;

            font-size: 21px;
            font-weight: 800;

            margin-bottom: 7px;
        }

        .otp-text {
            text-align: center;

            color: #6b7280;

            font-size: 12px;

            line-height: 1.6;

            margin-bottom: 18px;
        }

        .otp-email {
            color: #0072ff;

            font-weight: 700;

            word-break: break-word;
        }

        .otp-input {
            width: 100%;
            height: 55px;

            border: 1px solid #d8dee8;

            border-radius: 11px;

            outline: none;

            background: #f9fafb;

            text-align: center;

            letter-spacing: 7px;

            font-size: 21px;
            font-weight: 800;

            color: #111827;
        }

        .otp-input:focus {
            background: white;

            border-color: #0072ff;

            box-shadow:
                0 0 0 4px rgba(0,114,255,0.10);
        }

        .resend {
            display: block;

            margin: 14px auto 0;

            border: none;

            background: transparent;

            color: #0072ff;

            font-size: 12px;
            font-weight: 700;

            cursor: pointer;
        }

        .resend:hover {
            text-decoration: underline;
        }

        .back {
            display: block;

            margin: 12px auto 0;

            border: none;

            background: transparent;

            color: #6b7280;

            font-size: 11px;

            cursor: pointer;
        }

        .back:hover {
            color: #111827;
        }

        /* Spinner */
        .spinner {
            display: inline-block;

            width: 14px;
            height: 14px;

            margin-right: 6px;

            border: 2px solid rgba(255,255,255,0.4);

            border-top-color: white;

            border-radius: 50%;

            animation: spin 0.7s linear infinite;

            vertical-align: middle;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }


        /* ==================================
           MOBILE
           ================================== */

        @media (max-width: 600px) {

            body {
                min-height: 100dvh;

                /*
                 * IMPORTANT:
                 * Card ke around proper margin
                 */
                padding: 24px 16px;

                align-items: center;
            }

            .container {
                width: 100%;

                /*
                 * Card screen se chhota rahega
                 */
                max-width: 360px;
            }

            .card {
                width: 100%;

                padding: 25px 20px;

                border-radius: 20px;

                /*
                 * Full screen nahi
                 */
                min-height: auto;

                box-shadow:
                    0 18px 45px rgba(0,0,0,0.42);
            }

            .logo {
                width: 52px;
                height: 52px;

                margin-bottom: 11px;

                border-radius: 15px;

                font-size: 18px;
            }

            .title {
                font-size: 23px;

                margin-bottom: 5px;
            }

            .subtitle {
                font-size: 11px;

                margin-bottom: 19px;
            }

            .group {
                margin-bottom: 12px;
            }

            label {
                font-size: 11px;

                margin-bottom: 5px;
            }

            .input input {
                height: 45px;

                padding: 0 12px;

                border-radius: 10px;

                font-size: 12px;
            }

            .password-input {
                padding-right: 44px !important;
            }

            .eye {
                right: 10px;

                font-size: 16px;
            }

            .btn {
                height: 46px;

                margin-top: 5px;

                border-radius: 10px;

                font-size: 12px;
            }

            .login {
                margin-top: 15px;

                font-size: 11px;
            }

            .security {
                margin-top: 12px;

                font-size: 9px;
            }

            .otp-icon {
                width: 50px;
                height: 50px;

                margin-bottom: 11px;

                font-size: 21px;
            }

            .otp-title {
                font-size: 19px;
            }

            .otp-text {
                font-size: 11px;

                margin-bottom: 15px;
            }

            .otp-input {
                height: 50px;

                font-size: 19px;

                letter-spacing: 6px;
            }
        }


        /* Extra small phones */

        @media (max-width: 360px) {

            body {
                padding: 20px 13px;
            }

            .container {
                max-width: 340px;
            }

            .card {
                padding: 22px 17px;

                border-radius: 18px;
            }

            .logo {
                width: 48px;
                height: 48px;
            }

            .title {
                font-size: 21px;
            }

            .subtitle {
                font-size: 10px;
            }

            .input input {
                height: 43px;
            }

            .btn {
                height: 44px;
            }
        }
    </style>
</head>


<body>

    <div class="container">

        <div class="card">

            <!-- REGISTER -->

            <div id="registerSection">

                <div class="logo">
                    US
                </div>

                <h1 class="title">
                    Create Account
                </h1>

                <p class="subtitle">
                    Create your account and get started securely.
                </p>


                <form id="registerForm">

                    <!-- Username -->

                    <div class="group">

                        <label for="username">
                            Username
                        </label>

                        <div class="input">

                            <input
                                type="text"
                                id="username"
                                name="username"
                                placeholder="Enter your username"
                                minlength="3"
                                required
                                autocomplete="username"
                            >

                        </div>

                    </div>


                    <!-- Email -->

                    <div class="group">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input">

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter your email"
                                required
                                autocomplete="email"
                            >

                        </div>

                    </div>


                    <!-- Password -->

                    <div class="group">

                        <label for="password">
                            Password
                        </label>

                        <div class="input">

                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="password-input"
                                placeholder="Create a password"
                                minlength="6"
                                required
                                autocomplete="new-password"
                            >

                            <button
                                type="button"
                                class="eye"
                                id="togglePassword"
                            >
                                👁
                            </button>

                        </div>

                    </div>


                    <button
                        type="submit"
                        class="btn"
                        id="registerButton"
                    >
                        Create Account
                    </button>

                </form>


                <div
                    id="message"
                    class="message"
                ></div>


                <div class="login">

                    Already have an account?

                    <a href="/api/users/login">
                        Login
                    </a>

                </div>


                <div class="security">
                    🔒 Your information is securely protected
                </div>

            </div>


            <!-- OTP -->

            <div id="otpSection">

                <div class="otp-icon">
                    ✉
                </div>

                <h2 class="otp-title">
                    Verify Your Email
                </h2>

                <p class="otp-text">

                    Enter the 6-digit OTP sent to

                    <br>

                    <span
                        id="otpEmail"
                        class="otp-email"
                    ></span>

                </p>


                <form id="otpForm">

                    <input
                        type="text"
                        id="otp"
                        class="otp-input"
                        placeholder="000000"
                        maxlength="6"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        required
                    >

                    <button
                        type="submit"
                        class="btn"
                        id="verifyButton"
                    >
                        Verify OTP
                    </button>

                </form>


                <button
                    type="button"
                    class="resend"
                    id="resendButton"
                >
                    Resend OTP
                </button>


                <button
                    type="button"
                    class="back"
                    id="backButton"
                >
                    ← Back to registration
                </button>


                <div
                    id="otpMessage"
                    class="message"
                ></div>

            </div>

        </div>

    </div>


    <script>

        let userEmail = "";


        /* PASSWORD EYE */

        const password =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");


        togglePassword.addEventListener(
            "click",
            function () {

                if (password.type === "password") {

                    password.type = "text";

                    togglePassword.textContent = "🙈";

                } else {

                    password.type = "password";

                    togglePassword.textContent = "👁";

                }

            }
        );


        /* MESSAGE */

        function showMessage(
            element,
            text,
            type
        ) {

            element.textContent = text;

            element.className =
                "message " + type;
        }


        /* REGISTER */

        const registerForm =
            document.getElementById("registerForm");

        const registerButton =
            document.getElementById("registerButton");

        const message =
            document.getElementById("message");


        registerForm.addEventListener(
            "submit",
            async function (e) {

                e.preventDefault();

                message.className = "message";


                const username =
                    document
                    .getElementById("username")
                    .value
                    .trim();


                const email =
                    document
                    .getElementById("email")
                    .value
                    .trim();


                const passwordValue =
                    document
                    .getElementById("password")
                    .value;


                if (username.length < 3) {

                    showMessage(
                        message,
                        "Username must be at least 3 characters.",
                        "error"
                    );

                    return;
                }


                if (passwordValue.length < 6) {

                    showMessage(
                        message,
                        "Password must be at least 6 characters.",
                        "error"
                    );

                    return;
                }


                registerButton.disabled = true;

                registerButton.innerHTML =
                    '<span class="spinner"></span>Sending OTP...';


                try {

                    const response =
                        await fetch(
                            "/api/users/register",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    username: username,

                                    email: email,

                                    password: passwordValue

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            data.error ||
                            "Registration failed."
                        );
                    }


                    userEmail = email;


                    document.getElementById(
                        "registerSection"
                    ).style.display = "none";


                    document.getElementById(
                        "otpSection"
                    ).style.display = "block";


                    document.getElementById(
                        "otpEmail"
                    ).textContent = email;


                    showMessage(
                        document.getElementById("otpMessage"),
                        data.message ||
                        "OTP sent successfully. Check your email.",
                        "success"
                    );


                    document
                        .getElementById("otp")
                        .focus();


                } catch (error) {

                    showMessage(
                        message,
                        error.message ||
                        "Something went wrong.",
                        "error"
                    );

                } finally {

                    registerButton.disabled = false;

                    registerButton.textContent =
                        "Create Account";
                }

            }
        );


        /* OTP ONLY NUMBERS */

        const otpInput =
            document.getElementById("otp");


        otpInput.addEventListener(
            "input",
            function () {

                this.value =
                    this.value
                    .replace(/\D/g, "")
                    .slice(0, 6);

            }
        );


        /* VERIFY OTP */

        const otpForm =
            document.getElementById("otpForm");

        const verifyButton =
            document.getElementById("verifyButton");

        const otpMessage =
            document.getElementById("otpMessage");


        otpForm.addEventListener(
            "submit",
            async function (e) {

                e.preventDefault();


                const otp =
                    otpInput.value.trim();


                if (otp.length !== 6) {

                    showMessage(
                        otpMessage,
                        "Please enter a valid 6-digit OTP.",
                        "error"
                    );

                    return;
                }


                verifyButton.disabled = true;

                verifyButton.innerHTML =
                    '<span class="spinner"></span>Verifying...';


                try {

                    const response =
                        await fetch(
                            "/api/users/verify-otp",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    email: userEmail,

                                    otp: otp

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            data.error ||
                            "Invalid OTP."
                        );
                    }


                    showMessage(
                        otpMessage,
                        data.message ||
                        "Email verified successfully!",
                        "success"
                    );


                    verifyButton.textContent =
                        "Verified ✓";


                    setTimeout(
                        function () {

                            window.location.href =
                                "/api/users/login";

                        },
                        1200
                    );


                } catch (error) {

                    showMessage(
                        otpMessage,
                        error.message ||
                        "OTP verification failed.",
                        "error"
                    );


                    verifyButton.disabled = false;

                    verifyButton.textContent =
                        "Verify OTP";
                }

            }
        );


        /* RESEND OTP */

        const resendButton =
            document.getElementById("resendButton");


        resendButton.addEventListener(
            "click",
            async function () {

                if (!userEmail) {

                    showMessage(
                        otpMessage,
                        "Email not found. Please register again.",
                        "error"
                    );

                    return;
                }


                resendButton.disabled = true;

                resendButton.textContent =
                    "Sending...";


                try {

                    const response =
                        await fetch(
                            "/api/users/resend-otp",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    email: userEmail

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            data.error ||
                            "Could not resend OTP."
                        );
                    }


                    showMessage(
                        otpMessage,
                        data.message ||
                        "New OTP sent successfully.",
                        "success"
                    );


                } catch (error) {

                    showMessage(
                        otpMessage,
                        error.message ||
                        "Could not resend OTP.",
                        "error"
                    );

                } finally {

                    setTimeout(
                        function () {

                            resendButton.disabled = false;

                            resendButton.textContent =
                                "Resend OTP";

                        },
                        3000
                    );

                }

            }
        );


        /* BACK */

        document
            .getElementById("backButton")
            .addEventListener(
                "click",
                function () {

                    document.getElementById(
                        "otpSection"
                    ).style.display = "none";


                    document.getElementById(
                        "registerSection"
                    ).style.display = "block";


                    otpInput.value = "";

                    otpMessage.className =
                        "message";

                }
            );

    </script>

</body>
</html>