```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Account | User System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    min-height:100dvh;
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow-x:hidden;
    position:relative;

    background:
        radial-gradient(circle at 10% 15%,rgba(0,210,255,.20),transparent 28%),
        radial-gradient(circle at 90% 85%,rgba(124,58,237,.25),transparent 30%),
        linear-gradient(135deg,#050816,#0b1026,#111936);
}

/* TECH GRID */

body::before{
    content:"";
    position:absolute;
    inset:0;
    opacity:.35;

    background-image:
        linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);

    background-size:45px 45px;
}

/* GLOW */

body::after{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    border-radius:50%;
    right:-220px;
    top:-220px;

    background:radial-gradient(
        circle,
        rgba(0,217,255,.25),
        transparent 68%
    );

    filter:blur(8px);
}

/* CONTAINER */

.container{
    width:100%;
    max-width:440px;
    padding:20px;
    position:relative;
    z-index:2;
}

/* CARD */

.card{
    width:100%;
    background:rgba(255,255,255,.97);
    border-radius:24px;
    padding:36px;

    box-shadow:
        0 30px 80px rgba(0,0,0,.45),
        0 0 40px rgba(0,200,255,.08);

    animation:show .45s ease;
}

@keyframes show{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* LOGO */

.logo{
    width:60px;
    height:60px;
    margin:0 auto 15px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:17px;

    color:white;
    font-size:21px;
    font-weight:bold;

    background:linear-gradient(135deg,#06b6d4,#4f46e5);

    box-shadow:0 12px 30px rgba(37,99,235,.35);
}

/* HEADING */

.title{
    text-align:center;
    color:#111827;
    font-size:28px;
    margin-bottom:7px;
}

.subtitle{
    text-align:center;
    color:#6b7280;
    font-size:13px;
    margin-bottom:26px;
}

/* MESSAGE */

.message{
    display:none;
    padding:11px 13px;
    margin-bottom:16px;
    border-radius:9px;
    font-size:13px;
}

.message.success{
    display:block;
    color:#047857;
    background:#ecfdf5;
    border:1px solid #a7f3d0;
}

.message.error{
    display:block;
    color:#b91c1c;
    background:#fef2f2;
    border:1px solid #fecaca;
}

/* FORM */

.group{
    margin-bottom:16px;
}

label{
    display:block;
    margin-bottom:7px;
    color:#374151;
    font-size:13px;
    font-weight:600;
}

.input{
    position:relative;
}

.input input{
    width:100%;
    height:51px;
    padding:0 43px;

    border:1px solid #d7dce5;
    border-radius:11px;

    outline:none;
    background:#fff;

    color:#111827;
    font-size:14px;

    transition:.2s;
}

.input input:focus{
    border-color:#2563eb;
    box-shadow:0 0 0 4px rgba(37,99,235,.09);
}

.icon{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    font-size:16px;
}

.password input{
    padding-right:52px;
}

.eye{
    position:absolute;
    right:6px;
    top:50%;
    transform:translateY(-50%);

    width:38px;
    height:38px;

    border:0;
    background:transparent;
    border-radius:8px;

    cursor:pointer;
    font-size:17px;
}

/* BUTTON */

.btn{
    width:100%;
    height:51px;

    border:0;
    border-radius:11px;

    color:white;
    font-size:14px;
    font-weight:bold;

    cursor:pointer;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(37,99,235,.30);
}

.btn:disabled{
    opacity:.65;
    cursor:not-allowed;
    transform:none;
}

/* OTP */

#otpSection{
    display:none;
}

.otp-title{
    text-align:center;
    color:#111827;
    font-size:21px;
    margin-bottom:7px;
}

.otp-text{
    text-align:center;
    color:#6b7280;
    font-size:13px;
    margin-bottom:20px;
}

.otp{
    width:100%;
    height:57px;

    border:1px solid #d7dce5;
    border-radius:11px;

    outline:none;

    text-align:center;
    letter-spacing:10px;

    font-size:22px;
    font-weight:bold;

    color:#111827;
}

.otp:focus{
    border-color:#2563eb;
    box-shadow:0 0 0 4px rgba(37,99,235,.09);
}

.resend{
    text-align:center;
    margin-top:15px;
    color:#6b7280;
    font-size:13px;
}

.resend button{
    border:0;
    background:none;
    color:#2563eb;
    font-weight:bold;
    cursor:pointer;
}

/* LOGIN */

.login{
    text-align:center;
    margin-top:21px;
    color:#6b7280;
    font-size:13px;
}

.login a{
    color:#2563eb;
    text-decoration:none;
    font-weight:bold;
}

.security{
    text-align:center;
    color:#9ca3af;
    font-size:11px;
    margin-top:17px;
}

/* MOBILE FULL SCREEN */

@media(max-width:600px){

    body{
        min-height:100dvh;
        align-items:stretch;
    }

    .container{
        max-width:none;
        width:100%;
        min-height:100dvh;
        padding:0;
    }

    .card{
        min-height:100dvh;
        width:100%;

        border-radius:0;

        padding:
            max(28px,env(safe-area-inset-top))
            24px
            max(28px,env(safe-area-inset-bottom));

        display:flex;
        flex-direction:column;
        justify-content:center;
    }

    .title{
        font-size:25px;
    }

    .logo{
        width:58px;
        height:58px;
    }
}

@media(max-width:360px){

    .card{
        padding-left:18px;
        padding-right:18px;
    }

    .title{
        font-size:23px;
    }
}
</style>
</head>

<body>

<div class="container">

<div class="card">

    <div class="logo">US</div>

    <h1 class="title" id="title">
        Create Account
    </h1>

    <p class="subtitle" id="subtitle">
        Create your account and get started
    </p>

    <div id="message" class="message"></div>


    <!-- REGISTER -->

    <form id="registerForm">

        <div class="group">

            <label>Username</label>

            <div class="input">

                <span class="icon">👤</span>

                <input
                    type="text"
                    id="username"
                    placeholder="Enter your username"
                    minlength="3"
                    autocomplete="username"
                    required
                >

            </div>

        </div>


        <div class="group">

            <label>Email Address</label>

            <div class="input">

                <span class="icon">✉️</span>

                <input
                    type="email"
                    id="email"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >

            </div>

        </div>


        <div class="group">

            <label>Password</label>

            <div class="input password">

                <span class="icon">🔒</span>

                <input
                    type="password"
                    id="password"
                    placeholder="Create a strong password"
                    minlength="6"
                    autocomplete="new-password"
                    required
                >

                <button
                    type="button"
                    class="eye"
                    onclick="togglePassword()"
                >
                    👁️
                </button>

            </div>

        </div>


        <button
            type="submit"
            class="btn"
            id="registerBtn"
        >
            Create Account
        </button>

    </form>


    <!-- OTP -->

    <div id="otpSection">

        <h2 class="otp-title">
            Verify Your Email
        </h2>

        <p class="otp-text">
            Enter the 6-digit OTP sent to your email
        </p>

        <input
            class="otp"
            id="otp"
            type="text"
            inputmode="numeric"
            maxlength="6"
            placeholder="••••••"
            autocomplete="one-time-code"
        >

        <br><br>

        <button
            class="btn"
            id="verifyBtn"
            onclick="verifyOTP()"
        >
            Verify OTP
        </button>

        <div class="resend">
            Didn't receive the code?
            <button onclick="resendOTP()">
                Resend OTP
            </button>
        </div>

    </div>


    <div class="login">

        Already have an account?

        <a href="/api/users/login">
            Login
        </a>

    </div>

    <div class="security">
        🔒 Your account information is securely protected
    </div>

</div>

</div>


<script>

let userEmail = "";


/* PASSWORD */

function togglePassword(){

    const password =
        document.getElementById("password");

    password.type =
        password.type === "password"
        ? "text"
        : "password";
}


/* MESSAGE */

function showMessage(text,type){

    const message =
        document.getElementById("message");

    message.textContent = text;

    message.className =
        "message " + type;
}


/* REGISTER */

document
.getElementById("registerForm")
.addEventListener("submit",async function(e){

    e.preventDefault();

    const username =
        document.getElementById("username")
        .value.trim();

    const email =
        document.getElementById("email")
        .value.trim();

    const password =
        document.getElementById("password")
        .value;

    const btn =
        document.getElementById("registerBtn");


    if(username.length < 3){

        showMessage(
            "Username must be at least 3 characters.",
            "error"
        );

        return;
    }


    if(password.length < 6){

        showMessage(
            "Password must be at least 6 characters.",
            "error"
        );

        return;
    }


    userEmail = email;

    btn.disabled = true;
    btn.textContent = "Sending OTP...";


    try{

        const response =
            await fetch(
                "/api/users/register",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                        "application/json"
                    },

                    body:JSON.stringify({
                        username,
                        email,
                        password
                    })
                }
            );


        const data =
            await response.json();


        if(!response.ok){

            showMessage(
                data.message ||
                "Registration failed.",
                "error"
            );

            return;
        }


        showMessage(
            data.message ||
            "OTP sent successfully.",
            "success"
        );


        /* HIDE REGISTER */

        document
        .getElementById("registerForm")
        .style.display = "none";


        /* SHOW OTP */

        document
        .getElementById("otpSection")
        .style.display = "block";


        document
        .getElementById("title")
        .textContent = "Verify Email";


        document
        .getElementById("subtitle")
        .textContent =
        "Enter the verification code sent to your email.";


    }catch(error){

        console.error(error);

        showMessage(
            "Server error. Please try again.",
            "error"
        );

    }finally{

        btn.disabled = false;
        btn.textContent = "Create Account";

    }

});


/* OTP NUMBERS ONLY */

document
.getElementById("otp")
.addEventListener("input",function(){

    this.value =
        this.value
        .replace(/\D/g,"")
        .slice(0,6);

});


/* VERIFY OTP */

async function verifyOTP(){

    const otp =
        document
        .getElementById("otp")
        .value.trim();

    const btn =
        document
        .getElementById("verifyBtn");


    if(otp.length !== 6){

        showMessage(
            "Please enter the 6-digit OTP.",
            "error"
        );

        return;
    }


    btn.disabled = true;
    btn.textContent = "Verifying...";


    try{

        const response =
            await fetch(
                "/api/users/verify-otp",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                        "application/json"
                    },

                    body:JSON.stringify({
                        email:userEmail,
                        otp:otp
                    })
                }
            );


        const data =
            await response.json();


        if(!response.ok){

            showMessage(
                data.message ||
                "Invalid or expired OTP.",
                "error"
            );

            return;
        }


        showMessage(
            data.message ||
            "Email verified successfully!",
            "success"
        );


        btn.textContent = "Verified ✓";


        setTimeout(function(){

            window.location.href =
                "/api/users/login";

        },1200);


    }catch(error){

        console.error(error);

        showMessage(
            "Server error. Please try again.",
            "error"
        );

    }finally{

        if(btn.textContent === "Verifying..."){

            btn.disabled = false;
            btn.textContent = "Verify OTP";

        }

    }

}


/* RESEND OTP */

async function resendOTP(){

    if(!userEmail){

        showMessage(
            "Email not found.",
            "error"
        );

        return;
    }


    try{

        const response =
            await fetch(
                "/api/users/resend-otp",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                        "application/json"
                    },

                    body:JSON.stringify({
                        email:userEmail
                    })
                }
            );


        const data =
            await response.json();


        if(!response.ok){

            showMessage(
                data.message ||
                "Unable to resend OTP.",
                "error"
            );

            return;
        }


        showMessage(
            data.message ||
            "New OTP sent successfully.",
            "success"
        );


    }catch(error){

        console.error(error);

        showMessage(
            "Server error. Please try again.",
            "error"
        );

    }

}

</script>

</body>
</html>
```
