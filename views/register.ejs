```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | User System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* ===== BACKGROUND ===== */

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow: hidden;
            position: relative;

            background:
                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px),
                radial-gradient(circle at 15% 20%, rgba(0,210,255,.18), transparent 30%),
                radial-gradient(circle at 85% 80%, rgba(124,58,237,.22), transparent 32%),
                linear-gradient(135deg, #050816, #0b1026, #111936);

            background-size:
                45px 45px,
                45px 45px,
                auto,
                auto,
                auto;
        }

        body::before {
            content: "";
            position: absolute;
            width: 430px;
            height: 430px;
            top: -190px;
            right: -120px;
            border-radius: 50%;

            background: radial-gradient(
                circle,
                rgba(0,217,255,.25),
                rgba(0,217,255,.04) 48%,
                transparent 70%
            );

            filter: blur(8px);
        }

        body::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            bottom: -270px;
            left: -190px;
            border-radius: 50%;

            background: radial-gradient(
                circle,
                rgba(139,92,246,.28),
                rgba(139,92,246,.04) 48%,
                transparent 70%
            );

            filter: blur(10px);
        }

        /* ===== CONTAINER ===== */

        .container {
            width: 100%;
            max-width: 430px;
            position: relative;
            z-index: 5;
        }

        /* ===== CARD ===== */

        .card {
            background: rgba(255,255,255,.96);
            padding: 34px 34px;
            border-radius: 22px;

            border: 1px solid rgba(255,255,255,.8);

            box-shadow:
                0 30px 80px rgba(0,0,0,.45),
                0 0 40px rgba(0,200,255,.08);

            backdrop-filter: blur(20px);

            animation: showCard .5s ease;
        }

        @keyframes showCard {
            from {
                opacity: 0;
                transform: translateY(20px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ===== LOGO ===== */

        .logo {
            width: 58px;
            height: 58px;
            margin: 0 auto 14px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 16px;

            color: white;
            font-size: 20px;
            font-weight: 700;

            background:
                linear-gradient(135deg,#06b6d4,#4f46e5);

            box-shadow:
                0 10px 30px rgba(37,99,235,.35);
        }

        /* ===== HEADING ===== */

        h1 {
            text-align: center;
            color: #111827;
            font-size: 27px;
            margin-bottom: 7px;
        }

        .subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 25px;
        }

        /* ===== MESSAGE ===== */

        .message {
            display: none;
            padding: 11px 13px;
            margin-bottom: 16px;
            border-radius: 9px;
            font-size: 13px;
            line-height: 1.4;
        }

        .message.success {
            display: block;
            color: #047857;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .message.error {
            display: block;
            color: #b91c1c;
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        /* ===== FORM ===== */

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .input-box {
            position: relative;
        }

        .input-box input {
            width: 100%;
            height: 49px;

            padding: 0 43px;

            border: 1px solid #d7dce5;
            border-radius: 10px;

            outline: none;

            color: #111827;
            background: #fff;

            font-size: 14px;

            transition: .2s;
        }

        .input-box input:focus {
            border-color: #2563eb;

            box-shadow:
                0 0 0 4px rgba(37,99,235,.09);
        }

        .input-box input::placeholder {
            color: #9ca3af;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            z-index: 2;
        }

        /* ===== PASSWORD ===== */

        .password-box input {
            padding-right: 50px;
        }

        .eye-btn {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);

            width: 38px;
            height: 38px;

            border: none;
            border-radius: 8px;

            background: transparent;
            cursor: pointer;
            font-size: 17px;
        }

        .eye-btn:hover {
            background: #f3f4f6;
        }

        /* ===== BUTTON ===== */

        .main-btn {
            width: 100%;
            height: 49px;

            border: none;
            border-radius: 10px;

            color: white;
            background:
                linear-gradient(135deg,#2563eb,#4f46e5);

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: .2s;
        }

        .main-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 10px 25px rgba(37,99,235,.30);
        }

        .main-btn:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }

        /* ===== OTP SECTION ===== */

        #otpSection {
            display: none;
            animation: otpShow .35s ease;
        }

        @keyframes otpShow {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .otp-title {
            text-align: center;
            color: #111827;
            font-size: 20px;
            margin-bottom: 7px;
        }

        .otp-subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .otp-input {
            width: 100%;
            height: 55px;

            border: 1px solid #d7dce5;
            border-radius: 11px;

            outline: none;

            text-align: center;

            letter-spacing: 10px;

            font-size: 22px;
            font-weight: 700;

            color: #111827;

            transition: .2s;
        }

        .otp-input:focus {
            border-color: #2563eb;

            box-shadow:
                0 0 0 4px rgba(37,99,235,.09);
        }

        .resend {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
            color: #6b7280;
        }

        .resend button {
            border: none;
            background: none;
            color: #2563eb;
            font-weight: 600;
            cursor: pointer;
        }

        .resend button:hover {
            text-decoration: underline;
        }

        /* ===== LOGIN ===== */

        .login-text {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #6b7280;
        }

        .login-text a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        .login-text a:hover {
            text-decoration: underline;
        }

        /* ===== SECURITY ===== */

        .security {
            text-align: center;
            color: #9ca3af;
            font-size: 11px;
            margin-top: 17px;
        }

        /* ===== MOBILE ===== */

        @media(max-width:480px) {

            body {
                padding: 14px;
            }

            .card {
                padding: 28px 21px;
                border-radius: 18px;
            }

            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card">

        <div class="logo">
            US
        </div>

        <h1 id="pageTitle">
            Create Account
        </h1>

        <p class="subtitle" id="pageSubtitle">
            Create your account and get started
        </p>

        <div id="message" class="message"></div>


        <!-- ================= REGISTER ================= -->

        <form id="registerForm">

            <div class="form-group">

                <label for="username">
                    Username
                </label>

                <div class="input-box">

                    <span class="input-icon">👤</span>

                    <input
                        type="text"
                        id="username"
                        placeholder="Enter your username"
                        minlength="3"
                        autocomplete="username"
                        required
                    >

                </div>

            </div>


            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <div class="input-box">

                    <span class="input-icon">✉️</span>

                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <div class="input-box password-box">

                    <span class="input-icon">🔒</span>

                    <input
                        type="password"
                        id="password"
                        placeholder="Create a strong password"
                        minlength="6"
                        autocomplete="new-password"
                        required
                    >

                    <button
                        type="button"
                        class="eye-btn"
                        onclick="togglePassword()"
                    >
                        <span id="eyeIcon">👁️</span>
                    </button>

                </div>

            </div>


            <button
                type="submit"
                class="main-btn"
                id="registerButton"
            >
                Create Account
            </button>

        </form>


        <!-- ================= OTP ================= -->

        <div id="otpSection">

            <h2 class="otp-title">
                Verify Your Email
            </h2>

            <p class="otp-subtitle">
                Enter the 6-digit OTP sent to your email
            </p>

            <input
                type="text"
                id="otp"
                class="otp-input"
                maxlength="6"
                inputmode="numeric"
                autocomplete="one-time-code"
                placeholder="••••••"
            >

            <br><br>

            <button
                type="button"
                class="main-btn"
                id="verifyButton"
                onclick="verifyOTP()"
            >
                Verify OTP
            </button>

            <div class="resend">
                Didn't receive the code?
                <button
                    type="button"
                    onclick="resendOTP()"
                >
                    Resend OTP
                </button>
            </div>

        </div>


        <!-- LOGIN -->

        <div class="login-text">

            Already have an account?

            <a href="/api/users/login">
                Login
            </a>

        </div>


        <div class="security">
            🔒 Your account information is securely protected
        </div>

    </div>

</div>


<script>

    let userEmail = "";


    /* ================= PASSWORD ================= */

    function togglePassword() {

        const password =
            document.getElementById("password");

        const eye =
            document.getElementById("eyeIcon");

        if (password.type === "password") {

            password.type = "text";
            eye.textContent = "🙈";

        } else {

            password.type = "password";
            eye.textContent = "👁️";

        }
    }


    /* ================= MESSAGE ================= */

    function showMessage(text, type) {

        const message =
            document.getElementById("message");

        message.textContent = text;

        message.className =
            "message " + type;
    }


    /* ================= REGISTER ================= */

    document
        .getElementById("registerForm")
        .addEventListener("submit", async function(e) {

            e.preventDefault();

            const username =
                document.getElementById("username")
                    .value.trim();

            const email =
                document.getElementById("email")
                    .value.trim();

            const password =
                document.getElementById("password")
                    .value;

            const button =
                document.getElementById("registerButton");


            if (username.length < 3) {

                showMessage(
                    "Username must be at least 3 characters.",
                    "error"
                );

                return;
            }


            if (password.length < 6) {

                showMessage(
                    "Password must be at least 6 characters.",
                    "error"
                );

                return;
            }


            button.disabled = true;
            button.textContent = "Sending OTP...";


            try {

                const response =
                    await fetch(
                        "/api/users/register",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                username,
                                email,
                                password
                            })
                        }
                    );


                const data =
                    await response.json();


                if (!response.ok) {

                    showMessage(
                        data.message ||
                        "Registration failed.",
                        "error"
                    );

                    return;
                }


                userEmail = email;


                showMessage(
                    data.message ||
                    "OTP sent successfully to your email.",
                    "success"
                );


                /* Hide registration form */

                document
                    .getElementById("registerForm")
                    .style.display = "none";


                /* Show OTP */

                document
                    .getElementById("otpSection")
                    .style.display = "block";


                document
                    .getElementById("pageTitle")
                    .textContent = "Verify Email";


                document
                    .getElementById("pageSubtitle")
                    .textContent =
                    "We've sent a verification code to your email.";


            } catch (error) {

                console.error(error);

                showMessage(
                    "Server error. Please try again.",
                    "error"
                );

            } finally {

                button.disabled = false;
                button.textContent = "Create Account";

            }

        });


    /* ================= OTP ONLY NUMBERS ================= */

    document
        .getElementById("otp")
        .addEventListener("input", function() {

            this.value =
                this.value.replace(/\D/g, "").slice(0, 6);

        });


    /* ================= VERIFY OTP ================= */

    async function verifyOTP() {

        const otp =
            document.getElementById("otp")
                .value.trim();

        const button =
            document.getElementById("verifyButton");


        if (otp.length !== 6) {

            showMessage(
                "Please enter a valid 6-digit OTP.",
                "error"
            );

            return;
        }


        button.disabled = true;
        button.textContent = "Verifying...";


        try {

            const response =
                await fetch(
                    "/api/users/verify-otp",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            email: userEmail,
                            otp: otp
                        })
                    }
                );


            const data =
                await response.json();


            if (!response.ok) {

                showMessage(
                    data.message ||
                    "Invalid or expired OTP.",
                    "error"
                );

                return;
            }


            showMessage(
                data.message ||
                "Email verified successfully!",
                "success"
            );


            button.textContent = "Verified ✓";


            setTimeout(() => {

                window.location.href =
                    "/api/users/login";

            }, 1200);


        } catch (error) {

            console.error(error);

            showMessage(
                "Server error. Please try again.",
                "error"
            );

        } finally {

            button.disabled = false;

            if (button.textContent === "Verifying...") {
                button.textContent = "Verify OTP";
            }

        }

    }


    /* ================= RESEND OTP ================= */

    async function resendOTP() {

        if (!userEmail) return;


        try {

            const response =
                await fetch(
                    "/api/users/resend-otp",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            email: userEmail
                        })
                    }
                );


            const data =
                await response.json();


            if (!response.ok) {

                showMessage(
                    data.message ||
                    "Unable to resend OTP.",
                    "error"
                );

                return;
            }


            showMessage(
                data.message ||
                "New OTP sent successfully.",
                "success"
            );


        } catch (error) {

            console.error(error);

            showMessage(
                "Server error. Please try again.",
                "error"
            );

        }

    }

</script>

</body>
</html>

