<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup - Creatio</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background: #cbd5e1; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 15px; }
        .container { background: #fff; width: 950px; max-width: 100%; height: 580px; border-radius: 24px; display: flex; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15); }
        .form-side { flex: 1; background: linear-gradient(135deg, #f8f6f0, #faecd1); padding: 40px; display: flex; flex-direction: column; justify-content: center; position: relative; }
        .logo { position: absolute; top: 25px; left: 40px; font-weight: bold; color: #444; background: rgba(255,255,255,0.7); padding: 5px 15px; border-radius: 10px; font-size: 14px; }
        .header { text-align: center; margin-bottom: 20px; }
        .header h2 { font-size: 24px; margin-bottom: 5px; }
        .header p { font-size: 13px; color: #666; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-size: 11px; color: #777; margin-bottom: 5px; padding-left: 15px; }
        .form-group input { width: 100%; padding: 12px 20px; border: 1px solid rgba(0,0,0,0.05); border-radius: 30px; font-size: 13px; outline: none; }
        .form-group input:focus { border-color: #ffcc29; }
        .submit-btn { width: 100%; padding: 13px; background: #ffcc29; border: none; border-radius: 30px; font-size: 14px; font-weight: bold; cursor: pointer; margin-top: 5px; box-shadow: 0 4px 10px rgba(255,204,41,0.3); }
        #otp-section { display: none; }
        .otp-inputs { display: flex; justify-content: center; gap: 10px; margin: 20px 0; }
        .otp-box { width: 45px; height: 45px; text-align: center; font-size: 18px; font-weight: bold; border: 1px solid #ddd; border-radius: 10px; outline: none; }
        .otp-box:focus { border-color: #ffcc29; }
        .social-section { display: flex; gap: 10px; margin-top: 15px; }
        .social-btn { flex: 1; padding: 10px; background: rgba(255,255,255,0.8); border: 1px solid rgba(0,0,0,0.06); border-radius: 30px; font-size: 12px; cursor: pointer; }
        .footer { display: flex; justify-content: space-between; margin-top: 30px; font-size: 11px; color: #888; }
        .footer a { color: #444; text-decoration: none; font-weight: 500; }
        .image-side { flex: 1.1; background: url('https://unsplash.com') center/cover; position: relative; padding: 25px; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; }
        .top-badge { position: absolute; top: 25px; left: 25px; background: #fde047; padding: 8px 14px; border-radius: 10px; font-size: 11px; font-weight: bold; }
        .glass-box { background: rgba(255,255,255,0.25); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); border-radius: 14px; padding: 12px 18px; color: #fff; }
        .glass-box h4 { font-size: 13px; margin-bottom: 3px; }
        .glass-box p { font-size: 11px; opacity: 0.9; }
        @media (max-width: 800px) { .image-side { display: none; } .form-side { padding: 30px; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-side">
            <div class="logo">Creatio</div>
            
            <!-- 1. Signup Form -->
            <div id="signup-section">
                <div class="header"><h2>Create an account</h2><p>Sign up and get 30 day free trial</p></div>
                <form id="regForm">
                    <div class="form-group"><label>Fullname</label><input type="text" placeholder="Amélie Laurent" required></div>
                    <div class="form-group"><label>Email</label><input type="email" placeholder="amelielaurent@gmail.com" required></div>
                    <div class="form-group"><label>Password</label><input type="password" placeholder="••••••••" required></div>
                    <button type="submit" class="submit-btn">Submit & Send OTP</button>
                </form>
                <div class="social-section">
                    <button class="social-btn" onclick="alert('Apple login')"> Apple</button>
                    <button class="social-btn" onclick="alert('Google login')">Google</button>
                </div>
            </div>

            <!-- 2. OTP Form -->
            <div id="otp-section">
                <div class="header"><h2>Verify Your Email</h2><p>Enter 4-digit code sent to your email.</p></div>
                <form action="/auth/verify-otp" method="POST">
                    <div class="otp-inputs">
                        <input type="text" class="otp-box" name="otp1" id="otp1" maxlength="1" required oninput="move(this, 'otp2')">
                        <input type="text" class="otp-box" name="otp2" id="otp2" maxlength="1" required oninput="move(this, 'otp3')">
                        <input type="text" class="otp-box" name="otp3" id="otp3" maxlength="1" required oninput="move(this, 'otp4')">
                        <input type="text" class="otp-box" name="otp4" id="otp4" maxlength="1" required>
                    </div>
                    <button type="submit" class="submit-btn">Verify OTP</button>
                </form>
            </div>

            <div class="footer"><span>Already a user? <a href="/signin">Sign in</a></span><a href="/terms">Terms</a></div>
        </div>

        <!-- Right Panels (Laptop Only) -->
        <div class="image-side">
            <div class="top-badge">Task Review With Team<br><span style="font-weight:normal; opacity:0.8;">10:00 AM - 11:30 AM</span></div>
            <div class="glass-box"><h4>Project Calendar</h4><p style="word-spacing: 5px;">22 23 24 25 26 27 28</p></div>
            <div class="glass-box" style="background:#fff; color:#333;"><h4>Daily Meeting</h4><p style="color:#666;">12:00 PM - 01:00 PM</p></div>
        </div>
    </div>

    <script>
        document.getElementById('regForm').addEventListener('submit', function(e) {
            e.preventDefault();
            document.getElementById('signup-section').style.display = 'none';
            document.getElementById('otp-section').style.display = 'block';
            document.getElementById('otp1').focus();
        });
        function move(curr, nextId) { if (curr.value.length >= 1) document.getElementById(nextId).focus(); }
    </script>
</body>
</html>